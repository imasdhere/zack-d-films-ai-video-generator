        {"type": "icon", "name": "shield", "x": 540, "y": 520, "size": 210, "enter": "pop", "on": "defense", "delay": 0.24, "idle": "bob", "impact": true},
        {"type": "text", "text": "3 DEFENSES", "x": 540, "y": 1180, "size": 96, "color": "#FFE14D", "enter": "zoom", "on": "three"}
      ]
    },
    {
      "text": "Defense one: it's incredibly dry. Honey is about {*80%*|eighty percent} sugar, and only about {*17%*|seventeen percent} water.",
      "bg": ["#f7a531", "#5c2400"],
      "elements": [
        {"type": "text", "text": "DEFENSE #1", "x": 540, "y": 430, "size": 70, "bg": "#e53935", "enter": "zoom", "idle": "none"},
        {"type": "icon", "name": "honey-pot", "x": 540, "y": 690, "size": 320, "enter": "pop", "idle": "float"},
        {"type": "meter", "label": "Sugar", "value": 80, "color": "#FFC23A", "x": 540, "y": 980, "w": 780, "enter": "slideL", "on": "80%", "idle": "none"},
        {"type": "meter", "label": "Water", "value": 17, "color": "#53C3FF", "x": 540, "y": 1160, "w": 780, "enter": "slideR", "on": "17%", "idle": "none"}
      ]
    },
    {
      "text": "When bacteria land in it, the sugar pulls the water right out of their cells, and they dry up before they can grow.",
      "bg": ["#2fb7a8", "#022e33"],
      "elements": [
        {"type": "glow", "x": 540, "y": 820, "r": 400, "color": "#b6fff3", "idle": "none", "opacity": 0.45},
