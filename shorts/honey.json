        {"type": "text", "text": "pH ≈ 4", "x": 760, "y": 730, "size": 120, "color": "#7CFFB2", "enter": "zoom", "on": "four"},
        {"type": "icon", "name": "tangerine", "x": 760, "y": 980, "size": 270, "enter": "pop", "on": "orange", "idle": "float", "impact": true}
      ]
    },
    {
      "text": "Defense three is the sneakiest. Bees add an enzyme called *glucose* *oxidase*.",
