        {"type": "icon", "name": "droplet", "x": 790, "y": 900, "size": 130, "enter": "slideR", "on": "pulls", "delay": 0.1, "idle": "bob"},
        {"type": "icon", "name": "droplet", "x": 760, "y": 640, "size": 110, "enter": "slideR", "on": "water", "idle": "bob"},
        {"type": "icon", "name": "cross-mark", "x": 540, "y": 820, "size": 420, "enter": "zoom", "on": "dry", "idle": "none", "impact": true}
      ]
    },
    {
      "text": "Defense two: it's acidic. Most honey has a {pH|pee aitch} around *four*, about as acidic as orange juice.",
      "bg": ["#ffcf3a", "#6a3b00"],
      "elements": [
        {"type": "text", "text": "DEFENSE #2", "x": 540, "y": 430, "size": 70, "bg": "#e53935", "enter": "zoom", "idle": "none"},
